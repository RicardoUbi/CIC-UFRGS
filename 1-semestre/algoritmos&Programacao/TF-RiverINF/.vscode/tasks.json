{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build River-INF",
      "type": "shell",
      "command": "gcc",
      "args": [
        "src/main.c",
        "src/core/*.c",
        "-I",
        "src/include",
        "-I",
        "C:/raylib/include",
        "-L",
        "C:/raylib/lib",
        "-lraylib",
        "-lopengl32",
        "-lgdi32",
        "-lwinmm",
        "-o",
        "river-inf.exe"
      ],
      "options": {
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}